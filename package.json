{
  "name": "parareport",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "gemma:serve": "llama-server --model \"$GEMMA_GGUF_PATH\" --alias ${GEMMA_MODEL:-gemma-4-e2b-it} --host 127.0.0.1 --port ${GEMMA_PORT:-8081} --ctx-size ${GEMMA_CTX_SIZE:-4096} --reasoning off",
    "gemma:test": "node scripts/test-local-gemma.mjs",
    "reports:test": "node scripts/test-report-api.mjs",
    "test": "node --import ./scripts/test/register.mjs --test tests/*.test.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "demo:test": "node scripts/test-demo.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "16.4.2",
    "postcss": "8.5.30",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "22.10.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "typescript": "5.7.3"
  },
  "overrides": {
    "postcss": "8.5.30"
  }
}
